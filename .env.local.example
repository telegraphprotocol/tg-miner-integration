PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here

NEXT_PUBLIC_REGISTRY_CONTRACT=0xac683bFa8F1C892E23e8300d14c20678C6FC0CA3
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Validation API (server-side only — not exposed to the browser)
VALIDATOR_BASE_URL=http://<node-ip>:<port>
INTERNAL_SECRET=telegraph-internal-secret

# Accounts (email/password + wallet-link) — server-side only
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=telegraph_register_miner
AUTH_JWT_SECRET=replace-with-a-long-random-string

# Email delivery for OTP + magic links (SMTP) — same var names as telegraph-hackethon,
# so the same mailbox credentials can be reused directly
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
OUTLOOK_USER=your_outlook_user_here
OUTLOOK_PASS=your_outlook_password_here
